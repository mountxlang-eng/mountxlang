{
  "name": "mountx-vscode",
  "displayName": "MountX Language Support",
  "description": "Syntax highlighting and language support for the MountX programming language (.mx)",
  "version": "1.1.0",
  "publisher": "ZiadMohsin",
  "icon": "icons/mountx.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "mountx",
    "programming language",
    "syntax highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mountx",
        "aliases": [
          "MountX",
          "mountx"
        ],
        "extensions": [
          ".mx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mountx-16.png",
          "dark": "./icons/mountx-16.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "mountx",
        "scopeName": "source.mx",
        "path": "./syntaxes/mountx.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "mountx-icons",
        "label": "MountX File Icons",
        "path": "./icons/mountx-icon-theme.json"
      }
    ]
  }
}
