{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MountX",
  "scopeName": "source.mx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#function-declaration" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.mx",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.mx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mx",
          "match": "\\\\(?:[\"/\\\\bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mx",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.mx",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mx",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.mx",
          "match": "\\b(nullx|null|nil)\\b"
        },
        {
          "name": "variable.language.this.mx",
          "match": "\\b(thisx|this|selfx|self|super)\\b"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(funcx|func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.mx" },
        "2": { "name": "entity.name.function.mx" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mx",
          "match": "\\b(else\\s+if|if|else|while|loop|for|in|break|continue|return|tryx|catchx|throwx|throw)\\b"
        },
        {
          "name": "keyword.declaration.mx",
          "match": "\\b(let|funcx|func|classx|class|extends|newx|new|importx)\\b"
        },
        {
          "name": "keyword.control.boundary.mx",
          "match": "\\b(mountx|unmountx)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.mx",
          "match": "\\b(printx|inputx|readx|writex|appendx|exportx|typeofx|typeof|typex|lenx|len|length)\\b"
        },
        {
          "name": "support.function.native.mx",
          "match": "\\b(time_now_ms|sleep_ms|sys_args|sys_exit|os_env|os_cwd|os_listdir|os_sep|mx_version|http_get|db_open|db_exec|db_query|db_close|str_ord|str_chr|sys_exec)\\b"
        }
      ]
    },
    "function-calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.mx" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.mx",
          "match": "(&&|\\|\\||!|\\b(and|or|not)\\b)"
        },
        {
          "name": "keyword.operator.comparison.mx",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.mx",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.mx",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.mx",
          "match": "(,|\\.)"
        },
        {
          "name": "punctuation.bracket.mx",
          "match": "(\\{|\\}|\\[|\\]|\\(|\\))"
        }
      ]
    }
  }
}
