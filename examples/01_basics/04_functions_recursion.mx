# examples/01_basics/04_functions_recursion.mx
# Functions, multiple parameters, and recursion

mountx

func greet(name, title) {
    if title == nullx {
        return "Hello, " + name + "!"
    }
    return "Greetings, " + title + " " + name + "!"
}

func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func gcd(a, b) {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

printx(greet("Ziad", "Engineer"))
printx(greet("World", nullx))
printx("Factorial of 5: " + factorial(5))
printx("Factorial of 7: " + factorial(7))
printx("GCD of 48 and 18: " + gcd(48, 18))

unmountx
