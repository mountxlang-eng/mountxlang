# examples/06_database_sqlite/50_sqlite_crud.mx
# Full CRUD operations with parameterized queries

mountx
importx db

let conn = db.open(":memory:")
db.exec(conn, "CREATE TABLE products (id INTEGER PRIMARY KEY, title TEXT, price REAL, stock INTEGER);")

# 1. Create (Insert)
db.exec_params(conn, "INSERT INTO products (title, price, stock) VALUES (?, ?, ?);", ["Mechanical Keyboard", 89.99, 15])
db.exec_params(conn, "INSERT INTO products (title, price, stock) VALUES (?, ?, ?);", ["Gaming Mouse", 49.50, 30])
db.exec_params(conn, "INSERT INTO products (title, price, stock) VALUES (?, ?, ?);", ["4K Monitor", 299.00, 5])
printx("Products inserted.")

# 2. Read (Query with filter)
let expensive = db.query_params(conn, "SELECT title, price FROM products WHERE price > ?;", [50.0])
printx("Products over $50:")
for p in expensive {
    printx("  - " + p[0] + " ($" + p[1] + ")")
}

# 3. Update
db.exec_params(conn, "UPDATE products SET stock = stock - 1 WHERE title = ?;", ["Gaming Mouse"])
let mouse_stock = db.query_value(conn, "SELECT stock FROM products WHERE title = 'Gaming Mouse';")
printx("Updated Gaming Mouse stock: " + mouse_stock)

# 4. Delete
db.exec_params(conn, "DELETE FROM products WHERE title = ?;", ["Mechanical Keyboard"])
let remaining = db.query_value(conn, "SELECT count(*) FROM products;")
printx("Remaining products count: " + remaining)

db.close(conn)

unmountx
