mountx
importx os
importx io
importx time
importx string
importx process

func read_cpu_info() {
    let lines = io.read_lines("/proc/cpuinfo")
    let count = 0
    let model = "Unknown"
    for line in lines {
        if string.contains(line, "processor") {
            count = count + 1
        }
        if string.contains(line, "model name") {
            if model == "Unknown" {
                let parts = string.split(line, ":")
                if length(parts) > 1 {
                    model = parts[1]
                }
            }
        }
    }
    return [count, model]
}

func read_mem_info() {
    let lines = io.read_lines("/proc/meminfo")
    let total = 0
    let free = 0
    let available = 0
    for line in lines {
        if string.contains(line, "MemTotal") {
            let parts = string.split(line, ":")
            if length(parts) > 1 {
                let val = string.split(parts[1], " ")
                if length(val) > 0 {
                    total = val[0]
                }
            }
        }
        if string.contains(line, "MemFree") {
            let parts = string.split(line, ":")
            if length(parts) > 1 {
                let val = string.split(parts[1], " ")
                if length(val) > 0 {
                    free = val[0]
                }
            }
        }
        if string.contains(line, "MemAvailable") {
            let parts = string.split(line, ":")
            if length(parts) > 1 {
                let val = string.split(parts[1], " ")
                if length(val) > 0 {
                    available = val[0]
                }
            }
        }
    }
    return [total, free, available]
}

func read_uptime() {
    let content = io.read_text("/proc/uptime")
    let parts = string.split(content, " ")
    if length(parts) > 0 {
        return parts[0]
    }
    return "0"
}

func read_loadavg() {
    let content = io.read_text("/proc/loadavg")
    let parts = string.split(content, " ")
    let a = "0"
    let b = "0"
    let c = "0"
    if length(parts) > 0 { a = parts[0] }
    if length(parts) > 1 { b = parts[1] }
    if length(parts) > 2 { c = parts[2] }
    return [a, b, c]
}

func read_disk_info() {
    let result = process.run("df -h /")
    return result.output
}

func read_os_release() {
    let lines = io.read_lines("/etc/os-release")
    let name = "Unknown"
    for line in lines {
        if string.contains(line, "PRETTY_NAME") {
            let parts = string.split(line, "=")
            if length(parts) > 1 {
                name = parts[1]
            }
        }
    }
    return name
}

func str_to_int(s) {
    let n = 0
    let i = 0
    while i < length(s) {
        let c = s[i]
        if c == "0" { n = n * 10 + 0 }
        else if c == "1" { n = n * 10 + 1 }
        else if c == "2" { n = n * 10 + 2 }
        else if c == "3" { n = n * 10 + 3 }
        else if c == "4" { n = n * 10 + 4 }
        else if c == "5" { n = n * 10 + 5 }
        else if c == "6" { n = n * 10 + 6 }
        else if c == "7" { n = n * 10 + 7 }
        else if c == "8" { n = n * 10 + 8 }
        else if c == "9" { n = n * 10 + 9 }
        else { i = length(s) }
        i = i + 1
    }
    return n
}

func kb_to_mb(kb) {
    let n = str_to_int("" + kb)
    return idiv(n, 1024)
}

func main() {
    printx("========================================")
    printx("       SYSTEM RESOURCES MONITOR         ")
    printx("========================================")

    let os_name = read_os_release()
    printx("OS: " + os_name)

    let cwd = os.cwd()
    printx("Working Directory: " + cwd)

    let now = time.now_ms()
    printx("Timestamp (ms): " + ("" + now))

    printx("")
    printx("--- CPU INFO ---")
    let cpu = read_cpu_info()
    printx("CPU Cores: " + ("" + cpu[0]))
    printx("CPU Model: " + cpu[1])

    printx("")
    printx("--- MEMORY INFO ---")
    let mem = read_mem_info()
    let total_mb = kb_to_mb(mem[0])
    let free_mb = kb_to_mb(mem[1])
    let avail_mb = kb_to_mb(mem[2])
    let used_mb = total_mb - avail_mb
    printx("Total Memory:     " + ("" + total_mb) + " MB")
    printx("Free Memory:      " + ("" + free_mb) + " MB")
    printx("Available Memory: " + ("" + avail_mb) + " MB")
    printx("Used Memory:      " + ("" + used_mb) + " MB")

    printx("")
    printx("--- UPTIME ---")
    let up = read_uptime()
    printx("Uptime (seconds): " + up)

    printx("")
    printx("--- LOAD AVERAGE ---")
    let load = read_loadavg()
    printx("Load 1min:  " + load[0])
    printx("Load 5min:  " + load[1])
    printx("Load 15min: " + load[2])

    printx("")
    printx("--- DISK USAGE ---")
    let disk = read_disk_info()
    printx(disk)

    printx("")
    printx("--- TOP PROCESSES ---")
    let top = process.run("ps aux --sort=-%cpu | head -n 6")
    printx(top.output)

    printx("========================================")
    printx("       END OF SYSTEM REPORT             ")
    printx("========================================")
}

main()
unmountx
