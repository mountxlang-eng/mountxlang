# examples/05_system_and_io/46_benchmarking.mx
# Measuring execution duration with time module and sleep

mountx
importx time

let start_time = time.now_ms()
printx("Starting timer at: " + start_time + " ms")

# Simulate a short workload
let i = 0
let acc = 0
while i < 100000 {
    acc = acc + (i % 7)
    i = i + 1
}

let end_time = time.now_ms()
let elapsed = end_time - start_time
printx("Workload finished. Accumulator: " + acc)
printx("Elapsed time: " + elapsed + " ms")

unmountx
