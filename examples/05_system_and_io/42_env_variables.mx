# examples/05_system_and_io/42_env_variables.mx
# Reading environment variables and fallback values

mountx
importx os

printx("Reading environment variables:")

let user = os.env_or("USER", "UnknownUser")
printx("Current USER: " + user)

let home = os.env_or("HOME", "/home/default")
printx("HOME directory: " + home)

let custom_var = os.env_or("MOUNTX_ENV", "production-ready")
printx("MOUNTX_ENV (with fallback): " + custom_var)

unmountx
