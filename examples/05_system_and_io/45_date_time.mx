# examples/05_system_and_io/45_date_time.mx
# Date and time formatting and manipulation with datetime module

mountx
importx datetime

let dt = datetime.now()
printx("Current ISO datetime: " + dt.iso_format())
printx("Year:  " + dt.year)
printx("Month: " + dt.month)
printx("Day:   " + dt.day)
printx("Time:  " + dt.hour + ":" + dt.minute + ":" + dt.second)

printx("Custom format (YYYY-MM-DD): " + dt.format("YYYY-MM-DD"))
printx("Custom format (HH:mm:ss):   " + dt.format("HH:mm:ss"))

unmountx
