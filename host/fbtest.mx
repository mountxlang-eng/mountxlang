printx("== net ==")
T.check_eq(net.url_encode("a b&c"), "a%20b%26c", "url_encode")
T.check_eq(net.url_decode("a%20b%26c"), "a b&c", "url_decode")
T.check_eq(net.url_decode("a+b"), "a b", "url_decode plus")
T.check_eq(net.url_encode("a~b.c-d_e"), "a~b.c-d_e", "url_encode unreserved")
let up = net.url_parse("https://example.com:8080/x/y?k=1&k2=two#frag")
T.check_eq(map.pairs_get(up, "scheme"), "https", "url scheme")
T.check_eq(map.pairs_get(up, "host"), "example.com", "url host")
T.check_eq(map.pairs_get(up, "port"), "8080", "url port")
T.check_eq(map.pairs_get(up, "path"), "/x/y", "url path")
T.check_eq(map.pairs_get(up, "query"), "k=1&k2=two", "url query")
T.check_eq(map.pairs_get(up, "fragment"), "frag", "url fragment")
T.check_eq(net.url_build(up), "https://example.com:8080/x/y?k=1&k2=two#frag", "url round trip")
T.check_eq(net.query_encode(net.query_parse("a=1&b=two")), "a=1&b=two", "query round trip")
T.check_eq(map.pairs_get(net.query_parse("a=1&b=two+words"), "b"), "two words", "query plus = space")
let req = net.http_request_text("GET", "http://api.test/hi?x=1", [["Accept", "text/plain"]], "")
T.check_eq(req, "GET /hi HTTP/1.1\r\nHost: api.test\r\nAccept: text/plain\r\n\r\n", "http request text")
let resp = net.http_parse_response("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nhello body")
T.check_eq(resp[0], 200, "http status")
T.check_eq(resp[2], "hello body", "http body")
T.check_eq(resp[1][0], ["Content-Type", "text/plain"], "http header pair")

