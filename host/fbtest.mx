printx("== error ==")
let r_ok = error.attempt(cb_ok)
T.check_eq(r_ok[0], "ok", "attempt ok tag")
T.check_eq(error.result_value(r_ok), 7, "attempt ok value")
let r_bad = error.attempt(cb_bad)
T.check_eq(r_bad[0], "err", "attempt err tag")
T.check_eq(error.result_error(r_bad), "boom", "attempt err value")
let eobj = error.make_error("io", "no file")
T.check(type.is_instance(eobj, "MxError"), "MxError type")
T.check_eq(error.error_code(eobj), "io", "error_code")
T.check_eq(eobj.to_string(), "[io] no file", "to_string")
tryx {
    error.throw_error("db", "down")
} catchx(ex) {
    T.check(error.is_error(ex), "throw_error is MxError")
    T.check_eq(error.error_code(ex), "db", "throw_error code")
}
T.check_eq(error.retry(3, cb_bad)[0], "err", "retry exhausted")

