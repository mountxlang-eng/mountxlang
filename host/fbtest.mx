T.check_eq(map.pairs_get(v, "parent"), nullx, "json null value")
T.check_eq(map.pairs_get(v, "pi"), 1.5, "json float value")
T.check_eq(json.stringify_pairs(v), src, "json object round trip")
T.check_eq(json.stringify(json.parse("[1,2,[3],null]")), "[1,2,[3],null]", "json array round trip")
