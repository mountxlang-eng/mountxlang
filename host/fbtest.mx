let ps3 = map.pairs_set(ps2, "c", 3)
T.check_eq(map.pairs_keys(ps3), ["a", "b", "c"], "pairs_keys")
T.check_eq(map.pairs_remove(ps3, "a"), [["b", 9], ["c", 3]], "pairs_remove")
T.check_eq(map.pairs_values(ps2), [1, 9], "pairs_values")
T.check_eq(map.pairs_merge([["a", 1]], [["a", 2], ["b", 3]]), [["a", 2], ["b", 3]], "pairs_merge")

let s1 = newx Set()
s1.add_all([1, 2, 3])
s1.add(3)
T.check_eq(s1.size(), 3, "set dedup")
let s2 = newx Set()
s2.add_all([2, 3, 4])
T.check_eq(s1.union(s2).to_array(), [1, 2, 3, 4], "union")
T.check_eq(s1.intersection(s2).to_array(), [2, 3], "intersection")
T.check_eq(s1.difference(s2).to_array(), [1], "difference")
let s3 = newx Set()
s3.add_all([2, 3])
T.check(s3.is_subset(s1), "is_subset yes")
T.check(!s2.is_subset(s1), "is_subset no")
s1.remove(2)
T.check_eq(s1.to_array(), [1, 3], "set remove")

let h = newx HashTable()
for i in iter.range(20) {
    h.put("k" + i, i)
}
T.check_eq(h.size(), 20, "ht size after rehash")
T.check_eq(h.get("k0"), 0, "ht get first")
T.check_eq(h.get("k19"), 19, "ht get last")
T.check_eq(h.get("k7"), 7, "ht get mid")
h.put("k7", 777)
T.check_eq(h.get("k7"), 777, "ht update")
T.check_eq(h.size(), 20, "ht update no grow")
T.check(h.remove("k0"), "ht remove")
T.check(!h.has("k0"), "ht !has")
T.check(h.has("k19"), "ht has after rehash")
T.check_eq(h.size(), 19, "ht size after remove")
T.check_eq(h.get_or_default("nope", -1), -1, "ht get_or_default")

printx("== bst ==")
let t = newx BST()
for k in [50, 30, 70, 20, 40, 60, 80, 35, 45, 65] {
    t.insert(k, k * 10)
}
T.check_eq(t.keys(), [20, 30, 35, 40, 45, 50, 60, 65, 70, 80], "bst inorder")
T.check_eq(t.get(45), 450, "bst get")
T.check(t.has(45), "bst has")
T.check(!t.has(99), "bst !has")
T.check(t.remove(50), "bst remove two-children root")
T.check_eq(t.keys(), [20, 30, 35, 40, 45, 60, 65, 70, 80], "bst keys after 50")
T.check(t.remove(20), "bst remove leaf")
T.check(t.remove(30), "bst remove one-child")
T.check_eq(t.keys(), [35, 40, 45, 60, 65, 70, 80], "bst keys after")
T.check_eq(t.size(), 7, "bst size")
T.check_eq(t.min_key(), 35, "bst min")
T.check_eq(t.max_key(), 80, "bst max")
T.check_eq(t.height(), 3, "bst height")
T.check(!t.remove(999), "bst remove absent")
T.check_eq(t.entries()[0], [35, 350], "bst entries")

printx("== stack ==")
let s = newx Stack()
s.push(1)
s.push(2)
s.push(3)
T.check_eq(s.pop(), 3, "stack lifo")
T.check_eq(s.peek(), 2, "stack peek")
T.check_eq(s.size(), 2, "stack size")
T.check_eq(s.pop(), 2, "stack pop 2")
T.check_eq(s.pop(), 1, "stack pop 1")
T.check_eq(s.pop(), nullx, "stack empty pop")
T.check(s.is_empty(), "stack is_empty")

printx("== queue ==")
let q = newx Queue()
for x in iter.range(70) {
    q.enqueue(x)
}
let last_dq = -1
for i in iter.range(65) {
    last_dq = q.dequeue()
}
T.check_eq(last_dq, 64, "queue fifo 65th")
T.check_eq(q.size(), 5, "queue size after compaction")
T.check_eq(q.peek(), 65, "queue peek")
T.check_eq(q.dequeue(), 65, "queue dequeue")

printx("== linkedlist ==")
let ll = newx LinkedList()
ll.add_back(1)
ll.add_back(2)
ll.add_back(3)
ll.add_front(0)
T.check_eq(ll.to_array(), [0, 1, 2, 3], "ll build")
T.check(ll.remove_first(2), "ll remove mid")
T.check_eq(ll.to_array(), [0, 1, 3], "ll after remove")
ll.reverse()
T.check_eq(ll.to_array(), [3, 1, 0], "ll reverse")
T.check_eq(ll.peek_front(), 3, "ll peek_front")
T.check_eq(ll.peek_back(), 0, "ll peek_back")
T.check(ll.contains(1), "ll contains")
T.check_eq(ll.remove_front(), 3, "ll remove_front")
T.check_eq(ll.to_array(), [1, 0], "ll final")

