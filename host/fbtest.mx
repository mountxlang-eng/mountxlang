# ---- callbacks (top-level, hoisted; names chosen to clash with nothing) ----
func cb_double(x) { return x * 2 }
func cb_add(a, b) { return a + b }
func cb_even(x) { return x % 2 == 0 }
func cb_gt4(x) { return x > 4 }
func cb_lt3(x) { return x < 3 }
func cb_dup(x) { return [x, x] }
func cb_asc(a, b) { return a - b }
func cb_dbl(v) { return v * 2 }
func cb_inc(v) { return v + 1 }
func cb_kv_ge4(k, v) { return v >= 4 }
func cb_ok() { return 7 }
func cb_bad() { throwx "boom" }
func cb_noop() { return true }
func cb_throw_x() { throwx "xyz" }
func cb_idiv_zero() { return idiv(1, 0) }
func cb_query_closed() { return db.query(db_conn, "SELECT 1") }

# Scratch path that works on any machine, without writing into the repo.
# Same $TMPDIR pattern as examples/tour.mx - reused, not deleted (there is
# no delete primitive in the io/os modules yet).
func tmp_path(name) {
    let root = os.env_or("TMPDIR", "/tmp")
    if root == "" { root = "/tmp" }
    while len(root) > 1 {
        if root[len(root) - 1] != "/" { break }
        root = string.substr(root, 0, len(root) - 1)
    }
    return root + os.sep() + name
}

