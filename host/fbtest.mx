T.check_eq(os.path_basename("c.mx"), "c.mx", "basename no dir")
T.check_eq(os.path_parent("/a/b/c.mx"), "/a/b", "parent")
T.check_eq(os.path_ext("report.txt"), "txt", "ext")
T.check_eq(os.path_ext(".hidden"), "", "ext dotfile")
T.check_eq(os.path_ext("noext"), "", "ext none")
T.check_eq(os.env_or("MX_DEFINITELY_NOT_SET_12345", "fallback"), "fallback", "env_or")
T.check(type.is_string(os.cwd()), "cwd string")
T.check(type.is_array(os.listdir(".")), "listdir array")

printx("== io ==")
# $TMPDIR, never the repo root - see tmp_path() above.
let tmp = tmp_path("mountx_fbtest_tmp.txt")
T.check_eq(io.write_text(tmp, "line1\nline2"), true, "write_text")
T.check_eq(io.read_text(tmp), "line1\nline2", "read_text")
T.check_eq(io.append_line(tmp, "line3"), true, "append_line")
T.check_eq(io.read_text(tmp), "line1\nline2\nline3\n", "read after append")
# file now ends with \n, so the last split element is ""
T.check_eq(io.read_lines(tmp), ["line1", "line2", "line3", ""], "read_lines trailing newline")
T.check_eq(io.file_exists(tmp), true, "file_exists")
T.check_eq(io.file_exists("no_such_file_12345.txt"), false, "file_exists missing")
T.check_eq(io.read_text("no_such_file_12345.txt"), nullx, "read missing -> null")
T.check_eq(io.write_lines(tmp, ["x", "y"]), true, "write_lines")
T.check_eq(io.read_lines(tmp), ["x", "y"], "read_lines after write_lines")

printx("== natives: idiv / math_floor / mx_version ==")
T.check_eq(idiv(7, 2), 3, "native idiv pos")
T.check_eq(idiv(-7, 2), -3, "native idiv truncates toward zero")
T.check_eq(idiv(7, -2), -3, "native idiv negative divisor")
T.check_eq(idiv(-7, -2), 3, "native idiv both negative")
T.check_eq(idiv(0, 5), 0, "native idiv zero dividend")
T.check_eq(idiv(9, 3), 3, "native idiv exact")
T.check_eq(idiv(2, 7), 0, "native idiv smaller dividend")
T.check_eq(math_floor(2.9), 2, "native math_floor pos")
T.check_eq(math_floor(-2.1), -3, "native math_floor neg")
T.check_eq(math_floor(4), 4, "native math_floor int passthrough")
T.check_eq(mx_version(), "1.1.0", "mx_version matches interpreter VERSION")
T.check(type.is_string(mx_version()), "mx_version returns string")
let idiv_err = error.attempt(cb_idiv_zero)
T.check_eq(idiv_err[0], "err", "idiv by zero raises")
T.check_eq(error.result_error(idiv_err), "idiv: division by zero", "idiv error message")

printx("== module let access ==")
T.check(type.is_instance(random._default_rng, "Rand"), "random._default_rng reachable")
T.check(type.is_int(random._default_rng.s), "_default_rng.s is an int")
random.seed_rng(42)
let rng_a = random.rand_below(1000000)
random.seed_rng(42)
let rng_b = random.rand_below(1000000)
T.check_eq(rng_a, rng_b, "_default_rng reproducible after seed_rng")
T.check(random.rand_below(100) < 100, "rand_below stays in range")

printx("== db ==")
T.check_eq(typeofx(db), "module", "importx db resolves")
let db_conn = db.open(":memory:")
T.check(type.is_int(db_conn), "db.open returns a connection id")
T.check_eq(db.exec(db_conn, "CREATE TABLE t (id INT, name TEXT)"), -1, "DDL exec -> -1 rowcount")
T.check_eq(db.exec_params(db_conn, "INSERT INTO t VALUES (?, ?)", [1, "Ziad"]), 1, "exec_params -> 1 row")
T.check_eq(db.query(db_conn, "SELECT * FROM t"), [[1, "Ziad"]], "query round-trip")
T.check_eq(db.query_one(db_conn, "SELECT * FROM t"), [1, "Ziad"], "query_one")
T.check_eq(db.query_value(db_conn, "SELECT name FROM t WHERE id = 1"), "Ziad", "query_value")
T.check_eq(db.query_value(db_conn, "SELECT name FROM t WHERE id = 99"), nullx, "query_value no rows -> null")
T.check_eq(typeofx(db.close(db_conn)), "null", "db.close returns null")
let db_err = error.attempt(cb_query_closed)
T.check_eq(db_err[0], "err", "query after close raises")

printx("== natives: str_ord / str_chr / sys_exec ==")
T.check_eq(str_ord("A"), 65, "str_ord('A') == 65")
T.check_eq(str_chr(65), "A", "str_chr(65) == 'A'")
let exec_res = sys_exec("echo test_exec")
T.check_eq(exec_res[0], 0, "sys_exec returns 0 exit code")
T.check(string.contains(exec_res[1], "test_exec"), "sys_exec captures output")
let sys_exit_code = os.system("echo test_os_system")
T.check_eq(sys_exit_code, 0, "os.system returns 0 exit code")
let http_get_guard = ""
tryx { http_get(123) } catchx (e) { http_get_guard = "" + e }
T.check(string.contains(http_get_guard, "http_get expects 1 string argument"), "http_get validates argument")
let http_post_guard = ""
tryx { http_post(123) } catchx (e) { http_post_guard = "" + e }
T.check(string.contains(http_post_guard, "http_post expects (url, body, [content_type])"), "http_post validates arguments")

printx("== args ==")
let ap = args.create_parser("test", "test desc")
ap.add_flag("verbose", "v", "verbose mode")
ap.add_opt("name", "n", "guest", "user name")
ap.add_arg("file", "file name")
ap.parse(["--verbose", "--name=Ziad", "doc.txt"])
T.check_eq(ap.get("verbose"), true, "args flag set")
T.check_eq(ap.get("name"), "Ziad", "args opt set")
T.check_eq(ap.positionals(), ["doc.txt"], "args positionals")

printx("== enum ==")
let Colors = enum.create(["RED", "GREEN", "BLUE"])
T.check_eq(Colors.get("GREEN"), 1, "enum value")
T.check_eq(Colors.name_of(2), "BLUE", "enum name_of")
T.check(Colors.has_name("RED"), "enum has_name")

printx("== exception ==")
let val_err = newx exception.ValueError("bad value")
T.check_eq(val_err.to_string(), "ValueError: bad value", "ValueError to_string")
let caught = exception.try_or(cb_bad, "fallback")
T.check_eq(caught, "fallback", "try_or catches exception")

printx("== tuple ==")
let tup = tuple.create([10, 20, 30])
T.check_eq(tup.get(1), 20, "tuple get")
T.check_eq(tup.size(), 3, "tuple size")
T.check(tup.contains(30), "tuple contains")
T.check_eq(tup.to_string(), "(10, 20, 30)", "tuple to_string")

printx("== graph ==")
let g = graph.create(false)
g.add_edge("A", "B", 1)
g.add_edge("B", "C", 2)
T.check(g.has_edge("A", "B"), "graph has_edge")
T.check_eq(g.bfs("A"), ["A", "B", "C"], "graph bfs")
T.check_eq(g.shortest_path("A", "C"), ["A", "B", "C"], "graph shortest_path")

printx("== regex ==")
T.check(regex.is_match("^a+b$", "aaab"), "regex match plus")
T.check(regex.is_match("[0-9]+", "foo 123 bar"), "regex match class")
T.check(!regex.is_match("^xyz$", "abc"), "regex non match")
T.check_eq(regex.replace("[0-9]+", "NUM", "item 42 done"), "item NUM done", "regex replace")

printx("== datetime ==")
let dt = datetime.from_timestamp(1700000000000)
T.check_eq(dt.iso_format(), "2023-11-14T22:13:20", "datetime iso_format")
T.check_eq(dt.format("YYYY/MM/DD"), "2023/11/14", "datetime custom format")
T.check(datetime.is_leap_year(2024), "datetime is_leap_year true")
T.check(!datetime.is_leap_year(2023), "datetime is_leap_year false")

printx("== url ==")
let u = url.parse_url("https://mountx.org:8080/path?q=test#sec")
T.check_eq(u.scheme, "https", "url scheme")
T.check_eq(u.host, "mountx.org", "url host")
T.check_eq(u.port, 8080, "url port")
T.check_eq(u.param("q"), "test", "url query param")
T.check_eq(url.url_encode("hello world!"), "hello%20world%21", "url_encode")
T.check_eq(url.url_decode("hello%20world%21"), "hello world!", "url_decode")

printx("== process ==")
let pr = process.run("echo mountx_process_test")
T.check_eq(pr.code, 0, "process.run code 0")
T.check(string.contains(pr.output, "mountx_process_test"), "process.run output")
T.check(pr.success(), "process.run success")

printx("== buffer ==")
let buf = buffer.from_string("MountX")
T.check_eq(buf.size(), 6, "buffer size")
T.check_eq(buf.get(0), 77, "buffer get 'M'")
T.check_eq(buf.to_hex(), "4d6f756e7458", "buffer to_hex")
let buf2 = buffer.from_hex("4d6f756e7458")
T.check_eq(buf2.to_string(), "MountX", "buffer from_hex round-trip")

printx("== stdlib 1.1 ==")
T.check_eq(stdlib.stdlib_version(), "mountx stdlib 1.1 - 37 modules", "stdlib 1.1 version")

printx("== error diagnostics ==")
let caught_msg = ""
tryx {
    let dummy = undef_xyz_123
} catchx (e) {
    caught_msg = e
}
T.check_eq(caught_msg, "Undefined variable 'undef_xyz_123'", "catchx captures clean message without prefix")
T.check(!string.contains(caught_msg, "[Runtime]"), "catchx does not include [Runtime]")

func _nested_err_caller() {
    let dummy = undef_in_nested_fn
}
let caught_nested = ""
tryx {
    _nested_err_caller()
} catchx (e) {
    caught_nested = e
}
T.check_eq(caught_nested, "Undefined variable 'undef_in_nested_fn'", "catchx in nested call captures clean message")
T.check(!string.contains(caught_nested, "Traceback"), "catchx does not include Traceback")

printx("== socket & tcp ==")
let t_server = newx socket.TcpServer(19090, "127.0.0.1")
t_server.start()
let t_client = newx socket.TcpClient("127.0.0.1", 19090)
t_client.connect()
let t_conn = t_server.accept()
T.check(t_conn[0] > 0, "tcp server accepted client fd")
T.check_eq(t_conn[1], "127.0.0.1", "tcp accepted client ip")

let t_sent = t_client.send("PING_MOUNTX")
T.check_eq(t_sent, 11, "tcp client sent 11 bytes")
let t_recv = socket.recv(t_conn[0], 1024)
T.check_eq(t_recv, "PING_MOUNTX", "tcp server received data")

socket.send(t_conn[0], "PONG_MOUNTX")
let t_reply = t_client.recv(1024)
T.check_eq(t_reply, "PONG_MOUNTX", "tcp client received reply")

t_client.close()
socket.close(t_conn[0])
t_server.close()
T.check(true, "tcp sockets closed cleanly")

printx("== http_server & web framework ==")
func fb_web_handler(req, res) {
    res.json([["status", "ok"], ["target", req.param("name")]])
}

let fb_app = http_server.new_app()
fb_app.get("/hello/:name", fb_web_handler)

let fb_raw_req = "GET /hello/mountx?format=json HTTP/1.1\r\nHost: localhost\r\nUser-Agent: MountX-Test\r\n\r\n"
let fb_parsed = http_server.parse_request(fb_raw_req)
T.check_eq(fb_parsed.method, "GET", "http parser extracts GET method")
T.check_eq(fb_parsed.path, "/hello/mountx", "http parser extracts path")
T.check_eq(fb_parsed.query_param("format"), "json", "http parser extracts query param")

let fb_raw_res = fb_app.handle_raw(fb_raw_req)
T.check(string.contains(fb_raw_res, "200 OK"), "http server generates 200 OK")
T.check(string.contains(fb_raw_res, "\"target\":\"mountx\""), "http router matches params and builds JSON")

let fb_404_res = fb_app.handle_raw("GET /unknown/path HTTP/1.1\r\n\r\n")
T.check(string.contains(fb_404_res, "404 Not Found"), "http server generates 404 for unknown route")

printx("== orm & sqlite query builder ==")
let fb_db = orm.connect(":memory:")
fb_db.exec("CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT, qty INT);")
orm.table("items").insert([["name", "Apple"], ["qty", 10]])
orm.table("items").insert([["name", "Banana"], ["qty", 5]])
orm.table("items").insert([["name", "Cherry"], ["qty", 20]])
T.check_eq(orm.table("items").count(), 3, "orm counts inserted rows")

let fb_first = orm.table("items").where("name", "==", "Banana").first()
T.check_eq(fb_first.get("qty"), 5, "orm where and first finds row")

orm.table("items").where("name", "==", "Apple").update([["qty", 12]])
let fb_updated = orm.table("items").where("name", "==", "Apple").first()
T.check_eq(fb_updated.get("qty"), 12, "orm update modifies row")

orm.table("items").where("name", "==", "Cherry").delete()
T.check_eq(orm.table("items").count(), 2, "orm delete removes row")

classx FbItem extends orm.Model {
    func init() {
        super("items", nullx)
    }
}
let FbItems = newx FbItem()
let fb_created = FbItems.create([["name", "Date"], ["qty", 15]])
T.check_eq(fb_created.get("name"), "Date", "orm Model create returns new record")
T.check_eq(FbItems.find(fb_created.get("id")).get("qty"), 15, "orm Model find returns created entity")
orm.close_default()

T.summary()

unmountx