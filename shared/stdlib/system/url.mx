# url.mx - URL parsing and percent encoding (system/)
# Usage:
#   importx url
#   let u = url.parse("https://example.com:8080/path/to/page?user=ada&lang=mx#top")
#   u.scheme        # "https"
#   u.host          # "example.com"
#   u.port          # 8080
#   u.path          # "/path/to/page"
#   u.param("user") # "ada"
#   u.fragment      # "top"

importx string
importx dict

let _HEX_DIGITS = "0123456789ABCDEF"

func _is_hex_digit(c) {
    return (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
}

func _hex_to_int(c) {
    let d = string.index_of("0123456789", c)
    if d >= 0 { return d }
    if c == "a" || c == "A" { return 10 }
    if c == "b" || c == "B" { return 11 }
    if c == "c" || c == "C" { return 12 }
    if c == "d" || c == "D" { return 13 }
    if c == "e" || c == "E" { return 14 }
    if c == "f" || c == "F" { return 15 }
    return 0
}

func url_decode(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let ch = s[i]
        if ch == "+" {
            out = out + " "
            i = i + 1
        } else if ch == "%" && i + 2 < n {
            let h1 = s[i + 1]
            let h2 = s[i + 2]
            if _is_hex_digit(h1) && _is_hex_digit(h2) {
                let code = (_hex_to_int(h1) * 16) + _hex_to_int(h2)
                out = out + str_chr(code)
                i = i + 3
            } else {
                out = out + ch
                i = i + 1
            }
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}

func url_encode(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let ch = s[i]
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") ||
           (ch >= "0" && ch <= "9") || ch == "-" || ch == "_" || ch == "." || ch == "~" {
            out = out + ch
        } else {
            let code = str_ord(ch)
            let hi = idiv(code, 16)
            let lo = code % 16
            out = out + "%" + _HEX_DIGITS[hi] + _HEX_DIGITS[lo]
        }
        i = i + 1
    }
    return out
}

classx URL {
    let scheme = ""
    let host = ""
    let port = 0
    let path = ""
    let query = ""
    let fragment = ""
    let _params = nullx

    func init(scheme, host, port, path, query, fragment) {
        this.scheme = scheme
        this.host = host
        this.port = port
        this.path = path
        this.query = query
        this.fragment = fragment
        this._params = newx dict.Dict()

        if query != "" {
            let pairs = string.split(query, "&")
            for p in pairs {
                let eq = string.index_of(p, "=")
                if eq >= 0 {
                    let k = string.substr(p, 0, eq)
                    let v = string.substr(p, eq + 1, len(p))
                    this._params.set(url_decode(k), url_decode(v))
                } else if p != "" {
                    this._params.set(url_decode(p), "")
                }
            }
        }
    }

    func query_param(key) {
        if this._params.has(key) {
            return this._params.get(key)
        }
        return nullx
    }

    func param(key) {
        return this.query_param(key)
    }

    func params() {
        return this._params
    }

    func to_string() {
        let res = ""
        if this.scheme != "" {
            res = res + this.scheme + "://"
        }
        res = res + this.host
        if this.port > 0 {
            res = res + ":" + this.port
        }
        res = res + this.path
        if this.query != "" {
            res = res + "?" + this.query
        }
        if this.fragment != "" {
            res = res + "#" + this.fragment
        }
        return res
    }
}

func parse_url(url_str) {
    let s = url_str
    let scheme = ""
    let host = ""
    let port = 0
    let path = "/"
    let query = ""
    let fragment = ""

    # Scheme
    let colon_slash = string.index_of(s, "://")
    if colon_slash >= 0 {
        scheme = string.substr(s, 0, colon_slash)
        s = string.substr(s, colon_slash + 3, len(s))
    }

    # Fragment #
    let hash_idx = string.index_of(s, "#")
    if hash_idx >= 0 {
        fragment = string.substr(s, hash_idx + 1, len(s))
        s = string.substr(s, 0, hash_idx)
    }

    # Query ?
    let q_idx = string.index_of(s, "?")
    if q_idx >= 0 {
        query = string.substr(s, q_idx + 1, len(s))
        s = string.substr(s, 0, q_idx)
    }

    # Host & Port vs Path
    let slash_idx = string.index_of(s, "/")
    let host_part = s
    if slash_idx >= 0 {
        host_part = string.substr(s, 0, slash_idx)
        path = string.substr(s, slash_idx, len(s))
    } else {
        path = "/"
    }

    let colon_idx = string.index_of(host_part, ":")
    if colon_idx >= 0 {
        host = string.substr(host_part, 0, colon_idx)
        let port_str = string.substr(host_part, colon_idx + 1, len(host_part))
        port = string.tonum(port_str)
        if port == nullx { port = 0 }
    } else {
        host = host_part
    }

    return newx URL(scheme, host, port, path, query, fragment)
}
