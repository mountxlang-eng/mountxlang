# math.mx - MountX Standard Library

func abs(x) {
    if x < 0 {
        return 0 - x
    }
    return x
}

func max(a, b) {
    if a > b {
        return a
    }
    return b
}

func min(a, b) {
    if a > b {
        return b
    }
    return a
}

func pow(base, exp) {
    # FIX: negative exponent silently returned 1 before (loop ran 0 times)
    if exp < 0 {
        throwx "pow: negative exponents are not supported"
    }
    let result = 1
    loop exp {
        result = result * base
    }
    return result
}

func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func clamp(x, lo, hi) {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}